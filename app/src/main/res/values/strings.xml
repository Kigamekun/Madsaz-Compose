    <!-- Petunjuk tangisan -->
    <string name="cry_cues_signs">Ciri-ciri</string>
    <string name="cry_cues_actions">Yang bisa dilakukan</string>
    <string name="cue_neh_meaning">Lapar</string>
    <string name="cue_neh_description">Bayi mungkin merasa lapar dan ingin menyusu. Perhatikan tanda lain seperti membuka mulut, mengisap tangan, atau menoleh mencari sumber susu. Cobalah tawarkan ASI atau susu sesuai kebutuhan bayi.</string>
    <string name="cue_neh_metric_detail">Ingin menyusu</string>
    <string name="cue_neh_feature_1">Suara tangisan seperti ‘neh neh neh’</string>
    <string name="cue_neh_feature_2">Biasanya berulang dan semakin kuat</string>
    <string name="cue_neh_feature_3">Mencari puting atau membuka mulut</string>
    <string name="cue_owh_meaning">Lelah</string>
    <string name="cue_owh_description">Bayi mungkin mulai lelah dan membutuhkan tidur. Perhatikan tanda lain seperti menguap, mengusap mata, atau mulai rewel. Bantu bayi beristirahat di suasana yang tenang dengan cahaya lebih redup.</string>
    <string name="cue_owh_metric_detail">Mulai mengantuk</string>
    <string name="cue_owh_feature_1">Suara seperti ‘owh’ dengan nada panjang</string>
    <string name="cue_owh_feature_2">Menguap atau menggosok mata</string>
    <string name="cue_owh_feature_3">Gerakan bayi mulai melambat</string>
    <string name="cue_eh_meaning">Ingin bersendawa</string>
    <string name="cue_eh_description">Bayi mungkin ingin bersendawa karena ada udara yang tertelan saat menyusu. Bayi bisa tampak gelisah atau berhenti menyusu sejenak. Gendong dengan kepala tersangga dan bantu bersendawa secara lembut.</string>
    <string name="cue_eh_metric_detail">Sendawakan bayi</string>
    <string name="cue_eh_feature_1">Suara pendek seperti ‘eh’</string>
    <string name="cue_eh_feature_2">Muncul setelah bayi menyusu</string>
    <string name="cue_eh_feature_3">Bayi terlihat menggeliat atau tidak nyaman</string>
    <string name="cue_heh_meaning">Tidak nyaman</string>
    <string name="cue_heh_description">Bayi mungkin merasa tidak nyaman dengan popok, pakaian, suhu, atau posisi tubuhnya. Perhatikan apakah popok basah atau pakaian terasa terlalu ketat. Periksa satu per satu dan bantu bayi menemukan posisi yang nyaman.</string>
    <string name="cue_heh_metric_detail">Popok, suhu, atau posisi</string>
    <string name="cue_heh_feature_1">Suara seperti ‘heh’ dengan jeda pendek</string>
    <string name="cue_heh_feature_2">Bayi banyak bergerak atau merengek</string>
    <string name="cue_heh_feature_3">Ekspresi wajah tampak tidak nyaman</string>
    <string name="cue_eairh_meaning">Masuk angin</string>
    <string name="cue_eairh_description">Bayi mungkin merasa tidak nyaman pada perut, misalnya karena gas atau kembung. Perhatikan apakah bayi menarik kaki ke perut atau tampak mengejan. Coba tenangkan bayi dan bantu bersendawa dengan lembut.</string>
    <string name="cue_eairh_metric_detail">Perut kembung</string>
    <string name="cue_eairh_feature_1">Suara seperti ‘eairh’ dengan tekanan</string>
    <string name="cue_eairh_feature_2">Bayi menekuk kaki ke arah perut</string>
    <string name="cue_eairh_feature_3">Perut terasa penuh atau bayi sulit tenang</string>

