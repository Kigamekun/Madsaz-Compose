<?xml version="1.0" encoding="utf-8"?>
<!-- Rekaman bayi yang belum terkirim, ID tamu, dan sesi tidak boleh ikut pindah ke perangkat lain atau tersimpan di cloud. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
